# ============================================================================
# Blog & Content Kit — edge function secrets
# Set these in your Supabase project (Settings → Edge Functions → Secrets),
# not in the frontend .env. The frontend only needs the standard Supabase
# VITE_ vars your Lovable project already has.
# ============================================================================

# --- Required (provided by Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: AI gateway (Lovable AI Gateway by default) ---
LOVABLE_API_KEY=

# --- Required: canonical site URL, no trailing slash ---
PUBLIC_SITE_URL=https://yoursite.com

# --- Recommended: used in prompts, RSS, OG cards, transactional emails ---
SITE_NAME=Your Site

# --- Optional: RSS channel metadata ---
SITE_DESCRIPTION=Latest articles and insights.
SITE_LANGUAGE=nl

# --- Give-aways only: verified sender for your email provider ---
MAIL_FROM=Your Site <hi@notify.yoursite.com>

# --- Tool library only: name of a curated resource table to inject into articles ---
# Leave unset unless you set seo_settings.config.tool_library_enabled = true.
# TOOL_LIBRARY_TABLE=tool_library

# --- Autopilot only: extra internal hosts to skip in external-link validation ---
# Comma-separated. PUBLIC_SITE_URL's host is already included automatically.
# INTERNAL_HOSTS_EXTRA=yoursite.lovable.app,preview.yoursite.com
